# Приложение
APP_NAME=museum-consultant
DEBUG=false

# OpenAI / LLM (вложенные ключи OPENAI__)
OPENAI__API_KEY=sk-...
OPENAI__BASE_URL=https://api.polza.ai/v1
OPENAI__DEFAULT_MODEL=openai/gpt-4o-mini
OPENAI__REQUEST_TIMEOUT=30.0
OPENAI__MAX_RETRIES=3

# HTTP-прокси для LLM (оставьте пустым, если не нужен)
HTTP_PROXY=

# Redis
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
LOG_LEVEL=INFO
SECURITY_FILTERS_ENABLED=true

# Чат
CHAT_REPOSITORY=json
CHAT_STORAGE_DIR=./var/chats
CHAT_CONTEXT_STRATEGY=sliding
CHAT_CONTEXT_WINDOW=10
MODEL_CONTEXT_WINDOW=128000
RESPONSE_TOKENS=4096
SAFETY_MARGIN_TOKENS=256
DATABASE_URL=postgresql+asyncpg://chat_user:chat_pass@localhost:5432/chat_db

# Telegram-бот
BOT_TOKEN=
BACKEND_URL=http://localhost:8000
BACKEND_TIMEOUT=30.0
BOT_ADMIN_IDS=[]
BOT_API_PORT=9000
BOT_URL=http://localhost:9000
INTERNAL_TOKEN=change-me-internal
ADMIN_TOKEN=change-me-admin
PROXY=

# Эмбеддинги (ДЗ 5.1) — тот же ключ OPENAI__API_KEY
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIM=1536
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CACHE_DIR=./var/embeddings_cache

# Qdrant (ДЗ 5.2)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=change-me-qdrant
QDRANT_COLLECTION=documents

# RAG LlamaIndex (ДЗ 5.5)
RAG_DATA_DIR=./data/kb
RAG_CHUNK_SIZE=1024
RAG_CHUNK_OVERLAP=64
RAG_SIMILARITY_TOP_K=5
RAG_CHUNK_STRATEGY=fixed
RAG_RETRIEVE_K=24
RAG_RERANK_ENABLED=false
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
RAG_COLLECTION=rag_eval_1024
RAG_BAREMETAL_COLLECTION=rag_block_03_bare
RAG_SCORE_THRESHOLD=0.38
RAG_DOCSTORE_PATH=./var/ingestion/docstore_1024.json
OFFICIAL_SITE_ENABLED=true
OFFICIAL_SITE_BASE_URL=https://kazan-kremlin.ru
OFFICIAL_SITE_CACHE_TTL_SECONDS=600
OFFICIAL_SITE_TIMEOUT_SECONDS=12

# Оценка RAG (ДЗ 5.6) — судья через Polza, не Anthropic
EVAL_JUDGE_MODEL=openai/gpt-4o-mini
EVAL_EMBED_MODEL=openai/text-embedding-3-small
EVAL_CONCURRENCY=2
PHOENIX_ENABLED=true
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:4317

# Агент LangGraph (ДЗ 6.4) — memory | sqlite | postgres
AGENT_CHECKPOINTER=sqlite
AGENT_SQLITE_PATH=./var/agent_checkpoints.sqlite
